# ==============================================================================
# DEEPFAKE GUARDIAN AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# [REQUIRED] Google Gemini API Key
# Obtain free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# [REQUIRED FOR AUTHORIZATION FACTOR]
# Master Security Passkey required to authenticate or invite users.
# Prevents unauthorized access even if the web URL is publicly accessible.
MASTER_PASSKEY="GUARDIAN-SEC-2026-SHIELD"

# Secret salt used for secure HMAC password hashing
APP_SECRET_KEY="guardian-ai-secure-salt-key-change-in-production"

# Default Root Administrator Account (seeded on first startup)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="GuardianAdmin@2026!"

# Default Gemini model
GEMINI_MODEL="gemini-3.8-flash"
